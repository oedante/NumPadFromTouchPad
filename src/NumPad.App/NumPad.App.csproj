<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NumPad.App</RootNamespace>
    <AssemblyName>NumPadFromTouchPad</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>NumPad from TouchPad</Product>
    <Version>3.0.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Вызовы платформенных сборок защищены проверками OperatingSystem.IsXxx() в PlatformFactory. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NumPad.Core\NumPad.Core.csproj" />
    <ProjectReference Include="..\NumPad.Platform\NumPad.Platform.csproj" />
    <ProjectReference Include="..\NumPad.Platform.Windows\NumPad.Platform.Windows.csproj" />
    <ProjectReference Include="..\NumPad.Platform.Linux\NumPad.Platform.Linux.csproj" />
    <ProjectReference Include="..\NumPad.Platform.MacOS\NumPad.Platform.MacOS.csproj" />
  </ItemGroup>

</Project>
