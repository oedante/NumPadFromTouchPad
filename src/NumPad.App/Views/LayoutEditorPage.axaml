<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:NumPad.App.Controls"
             x:Class="NumPad.App.Views.LayoutEditorPage">
    <Grid Margin="28,24,28,20" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="DirtyMark" Text="● есть несохранённые изменения" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" IsVisible="False" />
                <Button x:Name="RevertButton" Content="Отменить изменения" />
                <Button x:Name="SaveButton" Content="Сохранить" />
                <Button x:Name="SaveApplyButton" Content="Сохранить и применить" Classes="primary" />
            </StackPanel>
            <TextBlock Classes="title" Text="Раскладки" />
        </DockPanel>

        <!-- Управление раскладками -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox x:Name="LayoutBox" Width="300" Margin="0,0,8,6" />
            <Button x:Name="NewButton" Content="Новая" Margin="0,0,8,6" />
            <Button x:Name="DuplicateButton" Content="Копия" Margin="0,0,8,6" />
            <Button x:Name="DeleteLayoutButton" Content="Удалить" Classes="danger" Margin="0,0,8,6" />
            <Button x:Name="ResetButton" Content="Вернуть стандартную" Margin="0,0,8,6" />
            <Button x:Name="ImportButton" Content="Импорт…" Margin="0,0,8,6" />
            <Button x:Name="ExportButton" Content="Экспорт…" Margin="0,0,8,6" />
        </WrapPanel>

        <!-- Инструменты -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="AddKeyButton" Content="+ Клавиша справа" Margin="0,0,8,6" />
            <Button x:Name="AddKeyBelowButton" Content="+ Снизу" Margin="0,0,8,6" />
            <Button x:Name="DeleteKeyButton" Content="Удалить клавишу" Margin="0,0,8,6" />
            <Button x:Name="UndoButton" Content="↶ Отменить" Margin="0,0,8,6" ToolTip.Tip="Ctrl+Z" />
            <Button x:Name="RedoButton" Content="↷ Повторить" Margin="0,0,16,6" ToolTip.Tip="Ctrl+Y" />
            <CheckBox x:Name="SnapBox" Content="Сетка" IsChecked="True" Margin="0,0,16,6" VerticalAlignment="Center" />
            <TextBlock Text="Промежуток, %:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox x:Name="GapBox" Width="64" Margin="0,0,16,6" />
            <TextBlock Text="Пропорции (Ш/В):" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox x:Name="AspectBox" Width="64" Margin="0,0,16,6" />
            <CheckBox x:Name="PointerOutsideBox" Content="Вне клавиш — курсор" VerticalAlignment="Center" Margin="0,0,0,6"
                      ToolTip.Tip="Касания вне прямоугольника клавиш двигают курсор (как зона трекпада в NUM10)" />
        </WrapPanel>

        <Grid Grid.Row="3" ColumnDefinitions="*,16,310">
            <Border Classes="card" Padding="8" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Classes="subtle" FontSize="12" Margin="8,6,8,2"
                               Text="Перетаскивайте клавиши мышью; угол — изменение размера. Стрелки — сдвиг (Shift — крупнее), Delete — удалить. Касания тачпада показываются поверх: видно, куда попадает палец, ещё до сохранения." />
                    <c:LayoutCanvas x:Name="EditorCanvas" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" Margin="0">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Classes="section" Text="Раскладка" />
                        <TextBlock Classes="label" Text="Название" />
                        <TextBox x:Name="NameBox" />

                        <TextBlock x:Name="KeyHeader" Classes="section" Text="Клавиша" Margin="0,18,0,0" />
                        <StackPanel x:Name="KeyPanel">
                            <TextBlock Classes="label" Text="Подпись на схеме" />
                            <TextBox x:Name="LabelBox" />
                            <TextBlock Classes="label" Text="Что делает клавиша" />
                            <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Нажимает клавишу" Tag="Key" />
                                <ComboBoxItem Content="Нажимает сочетание" Tag="Combo" />
                                <ComboBoxItem Content="Вводит текст" Tag="Text" />
                                <ComboBoxItem Content="Ничего (пустая зона)" Tag="None" />
                            </ComboBox>
                            <StackPanel x:Name="KeyChoicePanel">
                                <TextBlock Classes="label" Text="Клавиша" />
                                <ComboBox x:Name="KeyBox" HorizontalAlignment="Stretch" MaxDropDownHeight="380" />
                            </StackPanel>
                            <WrapPanel x:Name="ModifiersPanel" Margin="0,4,0,0">
                                <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,0,12,0" />
                                <CheckBox x:Name="ModShift" Content="Shift" Margin="0,0,12,0" />
                                <CheckBox x:Name="ModAlt" Content="Alt" Margin="0,0,12,0" />
                                <CheckBox x:Name="ModWin" Content="Win / Cmd" />
                            </WrapPanel>
                            <StackPanel x:Name="TextPanel">
                                <TextBlock Classes="label" Text="Текст" />
                                <TextBox x:Name="TextValueBox" />
                            </StackPanel>

                            <TextBlock Classes="label" Text="Положение и размер, % области" />
                            <Grid ColumnDefinitions="Auto,*,8,Auto,*" RowDefinitions="Auto,6,Auto">
                                <TextBlock Text="X " VerticalAlignment="Center" />
                                <TextBox x:Name="XBox" Grid.Column="1" />
                                <TextBlock Text="Y " Grid.Column="3" VerticalAlignment="Center" />
                                <TextBox x:Name="YBox" Grid.Column="4" />
                                <TextBlock Text="Ш " Grid.Row="2" VerticalAlignment="Center" />
                                <TextBox x:Name="WBox" Grid.Row="2" Grid.Column="1" />
                                <TextBlock Text="В " Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" />
                                <TextBox x:Name="HBox" Grid.Row="2" Grid.Column="4" />
                            </Grid>
                            <CheckBox x:Name="EnabledBox" Content="Зона включена" Margin="0,12,0,0" />
                            <CheckBox x:Name="RepeatBox" Content="Автоповтор при удержании" />
                        </StackPanel>
                        <TextBlock x:Name="NoSelection" Classes="subtle" Text="Выберите клавишу на схеме, чтобы изменить её расположение и назначение." Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="IssuesText" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="72" />
    </Grid>
</UserControl>
