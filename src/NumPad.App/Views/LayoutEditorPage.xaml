<UserControl x:Class="NumPad.App.Views.LayoutEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NumPad.App.Controls">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DirtyMark" Text="● есть несохранённые изменения" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
                <Button Content="Отменить изменения" Click="OnRevert" />
                <Button Content="Сохранить" Click="OnSave" />
                <Button Content="Сохранить и применить" Style="{StaticResource PrimaryButton}" Click="OnSaveApply" Margin="0" />
            </StackPanel>
            <TextBlock Text="Раскладки" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <!-- Управление раскладками -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox x:Name="LayoutBox" Width="280" DisplayMemberPath="Name" SelectionChanged="OnLayoutSelected" Margin="0,0,8,6" />
            <Button Content="Новая" Click="OnNew" Margin="0,0,8,6" />
            <Button Content="Копия" Click="OnDuplicate" Margin="0,0,8,6" />
            <Button x:Name="DeleteLayoutButton" Content="Удалить" Click="OnDeleteLayout" Style="{StaticResource DangerButton}" Margin="0,0,8,6" />
            <Button x:Name="ResetButton" Content="Вернуть стандартную" Click="OnReset" Margin="0,0,8,6" />
            <Button Content="Импорт…" Click="OnImport" Margin="0,0,8,6" />
            <Button Content="Экспорт…" Click="OnExport" Margin="0,0,8,6" />
        </WrapPanel>

        <!-- Инструменты -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="+ Клавиша" Click="OnAddKey" Margin="0,0,8,6" ToolTip="Добавить клавишу справа от выделенной" />
            <Button Content="+ Снизу" Click="OnAddKeyBelow" Margin="0,0,8,6" ToolTip="Добавить клавишу под выделенной" />
            <Button x:Name="DeleteKeyButton" Content="Удалить клавишу" Click="OnDeleteKey" Margin="0,0,8,6" />
            <Button x:Name="UndoButton" Content="↶ Отменить" Click="OnUndo" Margin="0,0,8,6" ToolTip="Ctrl+Z" />
            <Button x:Name="RedoButton" Content="↷ Повторить" Click="OnRedo" Margin="0,0,8,6" ToolTip="Ctrl+Y" />
            <CheckBox x:Name="SnapBox" Content="Сетка" IsChecked="True" Checked="OnSnapChanged" Unchecked="OnSnapChanged" Margin="8,0,16,6" VerticalAlignment="Center" />
            <TextBlock Text="Промежуток, %:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox x:Name="GapBox" Width="56" Margin="0,0,16,6" LostFocus="OnLayoutFieldCommit" KeyDown="OnFieldKeyDown" />
            <TextBlock Text="Пропорции (Ш/В):" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox x:Name="AspectBox" Width="56" Margin="0,0,16,6" LostFocus="OnLayoutFieldCommit" KeyDown="OnFieldKeyDown" />
            <CheckBox x:Name="PointerOutsideBox" Content="Вне клавиш — курсор" Checked="OnLayoutCheckChanged" Unchecked="OnLayoutCheckChanged" VerticalAlignment="Center" Margin="0,0,0,6"
                      ToolTip="Касания вне прямоугольника клавиш двигают курсор (как зона трекпада в NUM10)" />
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Subtle}" FontSize="12" Margin="8,6,8,2"
                               Text="Перетаскивайте клавиши мышью; угол — изменение размера. Стрелки — сдвиг (Shift — крупнее), Delete — удалить. Касания тачпада показываются поверх (раскладка ещё не применена)." />
                    <c:LayoutCanvas x:Name="EditorCanvas" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Раскладка" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" LostFocus="OnLayoutFieldCommit" KeyDown="OnFieldKeyDown" />

                        <TextBlock x:Name="KeyHeader" Text="Клавиша" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />
                        <StackPanel x:Name="KeyPanel">
                            <TextBlock Text="Подпись" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="LabelBox" LostFocus="OnKeyFieldCommit" KeyDown="OnFieldKeyDown" />
                            <TextBlock Text="Назначение" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged">
                                <ComboBoxItem Content="Клавиша" Tag="Key" />
                                <ComboBoxItem Content="Сочетание клавиш" Tag="Combo" />
                                <ComboBoxItem Content="Ввод текста" Tag="Text" />
                                <ComboBoxItem Content="Ничего (пустая зона)" Tag="None" />
                            </ComboBox>
                            <StackPanel x:Name="KeyChoicePanel">
                                <TextBlock Text="Клавиша" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="KeyBox" IsEditable="False" SelectionChanged="OnKeyChanged" MaxDropDownHeight="360" />
                            </StackPanel>
                            <WrapPanel x:Name="ModifiersPanel" Margin="0,4,0,0">
                                <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,4,12,4" Checked="OnModifierChanged" Unchecked="OnModifierChanged" />
                                <CheckBox x:Name="ModShift" Content="Shift" Margin="0,4,12,4" Checked="OnModifierChanged" Unchecked="OnModifierChanged" />
                                <CheckBox x:Name="ModAlt" Content="Alt" Margin="0,4,12,4" Checked="OnModifierChanged" Unchecked="OnModifierChanged" />
                                <CheckBox x:Name="ModWin" Content="Win" Margin="0,4,12,4" Checked="OnModifierChanged" Unchecked="OnModifierChanged" />
                            </WrapPanel>
                            <StackPanel x:Name="TextPanel">
                                <TextBlock Text="Текст" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TextValueBox" LostFocus="OnKeyFieldCommit" KeyDown="OnFieldKeyDown" />
                            </StackPanel>

                            <TextBlock Text="Положение и размер, % области" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Column="0" Grid.Row="0"><TextBlock Text="X " VerticalAlignment="Center" /><TextBox x:Name="XBox" LostFocus="OnKeyFieldCommit" KeyDown="OnFieldKeyDown" /></DockPanel>
                                <DockPanel Grid.Column="2" Grid.Row="0"><TextBlock Text="Y " VerticalAlignment="Center" /><TextBox x:Name="YBox" LostFocus="OnKeyFieldCommit" KeyDown="OnFieldKeyDown" /></DockPanel>
                                <DockPanel Grid.Column="0" Grid.Row="2"><TextBlock Text="Ш " VerticalAlignment="Center" /><TextBox x:Name="WBox" LostFocus="OnKeyFieldCommit" KeyDown="OnFieldKeyDown" /></DockPanel>
                                <DockPanel Grid.Column="2" Grid.Row="2"><TextBlock Text="В " VerticalAlignment="Center" /><TextBox x:Name="HBox" LostFocus="OnKeyFieldCommit" KeyDown="OnFieldKeyDown" /></DockPanel>
                            </Grid>
                            <CheckBox x:Name="EnabledBox" Content="Зона включена" Margin="0,12,0,4" Checked="OnKeyCheckChanged" Unchecked="OnKeyCheckChanged" />
                            <CheckBox x:Name="RepeatBox" Content="Автоповтор при удержании" Checked="OnKeyCheckChanged" Unchecked="OnKeyCheckChanged" />
                        </StackPanel>
                        <TextBlock x:Name="NoSelection" Style="{StaticResource Subtle}" Text="Выберите клавишу на схеме, чтобы изменить её." Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="IssuesText" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="72" />
    </Grid>
</UserControl>
