<UserControl x:Class="NumPad.App.Views.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NumPad.App.Controls">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Калибровка" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,12"
                       Text="Калибровка связывает реальные координаты касаний тачпада с клавишами наклейки. Она нужна после наклеивания наклейки и при смене раскладки." />
        </StackPanel>

        <!-- Индикатор шагов -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border x:Name="Step1Badge" CornerRadius="12" Padding="12,4" Margin="0,0,8,0"><TextBlock Text="1. Подготовка" /></Border>
            <Border x:Name="Step2Badge" CornerRadius="12" Padding="12,4" Margin="0,0,8,0"><TextBlock Text="2. Касания" /></Border>
            <Border x:Name="Step3Badge" CornerRadius="12" Padding="12,4" Margin="0,0,8,0"><TextBlock Text="3. Проверка и сохранение" /></Border>
        </StackPanel>

        <!-- Шаг 1 -->
        <ScrollViewer x:Name="PrepareStep" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Устройство и раскладка" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Тачпад" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName" SelectionChanged="OnDeviceChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Раскладка (наклейка)" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="LayoutBox" DisplayMemberPath="Name" SelectionChanged="OnLayoutChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CurrentCalibration" Style="{StaticResource Subtle}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Как проходит калибровка" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22">
                            1. Наклейка должна быть на тачпаде; режим NumPad на время калибровки выключается.<LineBreak />
                            2. Программа по очереди подсветит пять клавиш. Коснитесь центра подсвеченной клавиши на наклейке одним пальцем и отпустите.<LineBreak />
                            3. По касаниям вычисляется положение, масштаб и наклон наклейки. Затем проверьте результат: касайтесь клавиш — распознанные подсветятся.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="StartButton" Content="Начать калибровку" Style="{StaticResource PrimaryButton}" Click="OnStart" />
                            <Button Content="Проверить текущую" Click="OnTestCurrent" />
                            <Button Content="Сбросить калибровку" Style="{StaticResource DangerButton}" Click="OnResetCalibration" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ручная настройка границ" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Subtle}" Text="Где на тачпаде находится наклейка, в % от ширины и высоты тачпада (0 — левый/верхний край). Без поворота." Margin="0,0,0,8" />
                        <WrapPanel>
                            <TextBlock Text="Слева" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="LeftBox" Width="64" Margin="0,0,16,0" />
                            <TextBlock Text="Сверху" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="TopBox" Width="64" Margin="0,0,16,0" />
                            <TextBlock Text="Справа" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="RightBox" Width="64" Margin="0,0,16,0" />
                            <TextBlock Text="Снизу" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="BottomBox" Width="64" Margin="0,0,16,0" />
                            <Button Content="Проверить эти границы" Click="OnManualApply" />
                        </WrapPanel>
                        <TextBlock x:Name="ManualError" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Шаг 2 -->
        <Grid x:Name="CaptureStep" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Background="#FFF6D9" BorderBrush="{StaticResource AccentDarkBrush}">
                <StackPanel>
                    <TextBlock x:Name="CaptureInstruction" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureProgress" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <c:LayoutCanvas x:Name="CaptureCanvas" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="Отменить последнюю точку" Click="OnUndoPoint" />
                <Button Content="Начать заново" Click="OnRestart" />
                <Button Content="Отмена" Click="OnCancel" />
            </StackPanel>
        </Grid>

        <!-- Шаг 3 -->
        <Grid x:Name="TestStep" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="ResultCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultDetails" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                               Text="Проверка: касайтесь клавиш на наклейке — распознанная клавиша подсвечивается. Нажатия в другие программы сейчас не отправляются." />
                    <TextBlock x:Name="TestLog" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <c:LayoutCanvas x:Name="TestCanvas" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Сохранить калибровку" Style="{StaticResource PrimaryButton}" Click="OnSave" />
                <Button Content="Повторить калибровку" Click="OnStart" />
                <Button Content="Отмена" Click="OnCancel" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
