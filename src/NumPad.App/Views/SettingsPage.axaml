<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NumPad.App.Views.SettingsPage">
    <ScrollViewer>
        <StackPanel Margin="28,24,28,24" MaxWidth="860" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedMark" Text="✓ Сохранено" Foreground="{StaticResource OnBrush}" VerticalAlignment="Center" IsVisible="False" />
                    <Button x:Name="SaveButton" Content="Сохранить" Classes="primary" />
                </StackPanel>
                <TextBlock Classes="title" Text="Настройки" />
            </DockPanel>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Горячая клавиша" />
                    <TextBlock Classes="subtle" Text="Щёлкните в поле и нажмите нужное сочетание (например, Ctrl+Alt+N)." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <TextBox x:Name="HotkeyBox" Width="240" IsReadOnly="True" FontSize="16" />
                        <Button x:Name="ApplyHotkeyButton" Content="Назначить" />
                        <Button x:Name="DefaultHotkeyButton" Content="По умолчанию" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Поведение клавиш" />
                    <TextBlock Classes="label" Text="Когда срабатывает клавиша" />
                    <ComboBox x:Name="TriggerBox" Width="460">
                        <ComboBoxItem Content="При касании (как обычная клавиша, с удержанием)" Tag="OnTouchDown" />
                        <ComboBoxItem Content="При отпускании пальца (защита от случайных касаний)" Tag="OnRelease" />
                    </ComboBox>
                    <TextBlock Classes="label" Text="Если палец съехал на соседнюю клавишу" />
                    <ComboBox x:Name="SlideBox" Width="460">
                        <ComboBoxItem Content="Удерживать исходную клавишу" Tag="KeepKey" />
                        <ComboBoxItem Content="Отпустить клавишу" Tag="ReleaseOnExit" />
                    </ComboBox>
                    <CheckBox x:Name="RepeatBox" Content="Автоповтор при удержании" Margin="0,12,0,4" />
                    <Grid ColumnDefinitions="210,260,Auto" RowDefinitions="Auto,Auto" Margin="24,0,0,0">
                        <TextBlock Text="Задержка перед повтором" VerticalAlignment="Center" />
                        <Slider x:Name="DelaySlider" Grid.Column="1" Minimum="200" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="DelayText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Интервал повтора" VerticalAlignment="Center" />
                        <Slider x:Name="IntervalSlider" Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="IntervalText" Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox x:Name="NumLockBox" Content="Учитывать Num Lock (при выключенном цифры работают как стрелки/Home/End, как настоящий цифровой блок)" />
                    <CheckBox x:Name="PalmBox" Content="Игнорировать касания ладонью (по признаку устройства)" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Курсор и жесты в режиме NumPad" />
                    <ComboBox x:Name="SuppressBox" Width="560">
                        <ComboBoxItem Content="Блокировать курсор, пока палец на клавишах (рекомендуется)" Tag="WhileTouching" />
                        <ComboBoxItem Content="Блокировать курсор всё время, пока включён NumPad" Tag="AllWhileNumPad" />
                        <ComboBoxItem Content="Не блокировать курсор" Tag="None" />
                    </ComboBox>
                    <TextBlock x:Name="SuppressNote" Classes="subtle" FontSize="12" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="210,260,Auto" Margin="0,8,0,0">
                        <TextBlock Text="Блокировать после отрыва" VerticalAlignment="Center" />
                        <Slider x:Name="TailSlider" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="TailText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox x:Name="GesturesBox" Content="Отключать тапы и прокрутку тачпада средствами ОС на время режима NumPad" Margin="0,10,0,0" />
                    <TextBlock x:Name="GesturesNote" Classes="subtle" FontSize="12" Margin="28,0,0,0" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Запуск и окно" />
                    <CheckBox x:Name="AutostartBox" Content="Запускать при входе в систему" />
                    <CheckBox x:Name="MinimizedBox" Content="Запускать свёрнутым в трей" />
                    <CheckBox x:Name="CloseToTrayBox" Content="Закрытие окна сворачивает программу в трей" />
                    <CheckBox x:Name="RestoreModeBox" Content="Восстанавливать режим NumPad при запуске" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Диагностика и сброс" />
                    <CheckBox x:Name="LogBox" Content="Вести технический журнал (без записи нажимаемых клавиш)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button x:Name="OpenFolderButton" Content="Открыть папку настроек" />
                        <Button x:Name="ResetButton" Content="Сбросить настройки" Classes="danger" />
                    </StackPanel>
                    <TextBlock Classes="subtle" FontSize="12" Margin="0,8,0,0"
                               Text="Сброс возвращает параметры по умолчанию. Раскладки и калибровки устройств сохраняются." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
