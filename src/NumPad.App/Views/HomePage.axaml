<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:NumPad.App.Controls"
             x:Class="NumPad.App.Views.HomePage">
    <ScrollViewer>
        <StackPanel Margin="28,24,28,24">
            <TextBlock Classes="title" Text="Главная" />
            <TextBlock Classes="subtle" Text="Тачпад превращается в цифровой блок по нажатию горячей клавиши." Margin="0,4,0,16" />

            <Border x:Name="ErrorCard" Classes="card" BorderBrush="{StaticResource ErrorBrush}" IsVisible="False">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
            </Border>

            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border x:Name="ModeBadge" CornerRadius="12" Padding="12,4" Background="{StaticResource BadgeOffBrush}">
                                <TextBlock x:Name="ModeBadgeText" Text="ВЫКЛ" FontWeight="Bold" FontSize="13" />
                            </Border>
                            <TextBlock x:Name="ModeTitle" Text="Режим NumPad выключен" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ModeHint" Classes="subtle" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button x:Name="ModeButton" Grid.Column="1" Classes="primary" MinWidth="170" Height="44"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Content="Включить NumPad" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,12,*,12,*">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Устройство" Margin="0,0,0,4" />
                        <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="DeviceStatus" Classes="subtle" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Раскладка" Margin="0,0,0,4" />
                        <ComboBox x:Name="LayoutBox" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="CalibrationStatus" Classes="subtle" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Горячая клавиша" Margin="0,0,0,4" />
                        <TextBlock x:Name="HotkeyText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="HotkeyStatus" Classes="subtle" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenCalibration" Content="Калибровка" />
                            <Button x:Name="OpenEditor" Content="Редактор раскладки" />
                        </StackPanel>
                        <TextBlock Classes="section" Text="Предпросмотр" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <TextBlock Classes="subtle" Text="Касания тачпада показываются в реальном времени; распознанные клавиши подсвечиваются." Margin="0,6,0,8" />
                    <c:LayoutCanvas x:Name="Preview" Height="320" />
                </StackPanel>
            </Border>

            <Border x:Name="WarningsCard" Classes="card" IsVisible="False">
                <StackPanel>
                    <TextBlock Classes="section" Text="Предупреждения" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock x:Name="WarningsText" TextWrapping="Wrap" />
                    <Button x:Name="DismissWarnings" Content="Скрыть" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
