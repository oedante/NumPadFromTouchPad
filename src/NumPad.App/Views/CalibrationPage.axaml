<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:NumPad.App.Controls"
             x:Class="NumPad.App.Views.CalibrationPage">
    <Grid Margin="28,24,28,20" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="Калибровка" />
            <TextBlock Classes="subtle" Margin="0,4,0,12"
                       Text="Калибровка связывает реальные координаты касаний тачпада с клавишами наклейки. Её нужно пройти после наклеивания наклейки и при смене раскладки." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Border x:Name="Step1Badge" CornerRadius="12" Padding="12,4"><TextBlock Text="1. Подготовка" /></Border>
            <Border x:Name="Step2Badge" CornerRadius="12" Padding="12,4"><TextBlock Text="2. Касания" /></Border>
            <Border x:Name="Step3Badge" CornerRadius="12" Padding="12,4"><TextBlock Text="3. Проверка и сохранение" /></Border>
        </StackPanel>

        <!-- Шаг 1 -->
        <ScrollViewer x:Name="PrepareStep" Grid.Row="2">
            <StackPanel>
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Устройство и раскладка" />
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="Тачпад" />
                                <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="Раскладка (наклейка)" />
                                <ComboBox x:Name="LayoutBox" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CurrentCalibration" Classes="subtle" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Как проходит калибровка" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22"
                                   Text="1. Наклейка должна быть на тачпаде; режим NumPad на время калибровки выключается.&#10;2. Программа по очереди подсветит пять клавиш. Коснитесь центра подсвеченной клавиши на наклейке одним пальцем и отпустите.&#10;3. По касаниям вычисляются положение, масштаб и наклон наклейки. Затем проверьте результат: касайтесь клавиш — распознанные подсветятся." />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                            <Button x:Name="StartButton" Content="Начать калибровку" Classes="primary" />
                            <Button x:Name="TestCurrentButton" Content="Проверить текущую" />
                            <Button x:Name="ResetCalibrationButton" Content="Сбросить калибровку" Classes="danger" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Ручная настройка границ" />
                        <TextBlock Classes="subtle" Margin="0,0,0,8"
                                   Text="Где на тачпаде находится наклейка, в % от ширины и высоты тачпада (0 — левый/верхний край). Без поворота." />
                        <WrapPanel>
                            <TextBlock Text="Слева" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="LeftBox" Width="70" Margin="0,0,16,6" />
                            <TextBlock Text="Сверху" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="TopBox" Width="70" Margin="0,0,16,6" />
                            <TextBlock Text="Справа" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="RightBox" Width="70" Margin="0,0,16,6" />
                            <TextBlock Text="Снизу" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="BottomBox" Width="70" Margin="0,0,16,6" />
                            <Button x:Name="ManualButton" Content="Проверить эти границы" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock x:Name="ManualError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Шаг 2 -->
        <Grid x:Name="CaptureStep" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*,Auto">
            <Border Classes="card" Background="{StaticResource HintBrush}" BorderBrush="{StaticResource AccentDarkBrush}">
                <StackPanel>
                    <TextBlock x:Name="CaptureInstruction" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureProgress" Classes="subtle" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Classes="card" Padding="8">
                <c:LayoutCanvas x:Name="CaptureCanvas" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UndoPointButton" Content="Отменить последнюю точку" />
                <Button x:Name="RestartButton" Content="Начать заново" />
                <Button x:Name="CancelCaptureButton" Content="Отмена" />
            </StackPanel>
        </Grid>

        <!-- Шаг 3 -->
        <Grid x:Name="TestStep" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*,Auto">
            <Border Classes="card">
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultDetails" Classes="subtle" Margin="0,4,0,0" />
                    <TextBlock Classes="subtle" Margin="0,8,0,0"
                               Text="Проверка: касайтесь клавиш на наклейке — распознанная клавиша подсвечивается. Нажатия в другие программы сейчас не отправляются." />
                    <TextBlock x:Name="TestLog" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Classes="card" Padding="8">
                <c:LayoutCanvas x:Name="TestCanvas" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveCalibrationButton" Content="Сохранить калибровку" Classes="primary" />
                <Button x:Name="RepeatButton" Content="Повторить калибровку" />
                <Button x:Name="CancelTestButton" Content="Отмена" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
