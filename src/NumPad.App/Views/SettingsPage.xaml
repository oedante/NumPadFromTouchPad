<UserControl x:Class="NumPad.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="820" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedMark" Text="✓ Сохранено" Foreground="{StaticResource OnBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="OnSave" Margin="0" />
                </StackPanel>
                <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Горячая клавиша" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Subtle}" Text="Щёлкните в поле и нажмите нужное сочетание (например, Ctrl+Alt+N)." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="HotkeyBox" Width="240" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" FontSize="16" Margin="0,0,8,0"
                                 IsReadOnlyCaretVisible="True" />
                        <Button Content="Назначить" Click="OnApplyHotkey" />
                        <Button Content="По умолчанию" Click="OnDefaultHotkey" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Поведение клавиш" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Когда срабатывает клавиша" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TriggerBox" Width="420" HorizontalAlignment="Left">
                        <ComboBoxItem Content="При касании (как обычная клавиша, с удержанием)" Tag="OnTouchDown" />
                        <ComboBoxItem Content="При отпускании пальца (защита от случайных касаний)" Tag="OnRelease" />
                    </ComboBox>
                    <TextBlock Text="Если палец съехал на соседнюю клавишу" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SlideBox" Width="420" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Удерживать исходную клавишу" Tag="KeepKey" />
                        <ComboBoxItem Content="Отпустить клавишу" Tag="ReleaseOnExit" />
                    </ComboBox>
                    <CheckBox x:Name="RepeatBox" Content="Автоповтор при удержании" Margin="0,12,0,4" />
                    <Grid Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Задержка перед повтором" VerticalAlignment="Center" />
                        <Slider x:Name="DelaySlider" Grid.Column="1" Minimum="200" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" Margin="0,6" />
                        <TextBlock x:Name="DelayText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Интервал повтора" VerticalAlignment="Center" />
                        <Slider x:Name="IntervalSlider" Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" Margin="0,6" />
                        <TextBlock x:Name="IntervalText" Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox x:Name="NumLockBox" Content="Учитывать Num Lock (при выключенном — цифры работают как стрелки/Home/End, как настоящий цифровой блок)" />
                    <CheckBox x:Name="PalmBox" Content="Игнорировать касания ладонью (по признаку устройства)" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Курсор и жесты в режиме NumPad" Style="{StaticResource SectionTitle}" />
                    <ComboBox x:Name="SuppressBox" Width="520" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Блокировать курсор, пока палец на клавишах (рекомендуется)" Tag="WhileTouching" />
                        <ComboBoxItem Content="Блокировать любую мышь, пока включён NumPad" Tag="AllWhileNumPad" />
                        <ComboBoxItem Content="Не блокировать курсор" Tag="None" />
                    </ComboBox>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Блокировать после отрыва" VerticalAlignment="Center" />
                        <Slider x:Name="TailSlider" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="TailText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox x:Name="GesturesBox" Content="Отключать тапы и прокрутку тачпада на время режима NumPad" Margin="0,10,0,0" />
                    <TextBlock x:Name="GesturesNote" Style="{StaticResource Subtle}" FontSize="12" Margin="24,0,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Запуск и окно" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows" />
                    <CheckBox x:Name="MinimizedBox" Content="Запускать свёрнутым в трей" />
                    <CheckBox x:Name="CloseToTrayBox" Content="Закрытие окна сворачивает программу в трей" />
                    <CheckBox x:Name="NotifyBox" Content="Показывать уведомления о смене режима" />
                    <CheckBox x:Name="RestoreModeBox" Content="Восстанавливать режим NumPad при запуске" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Диагностика и сброс" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="LogBox" Content="Вести технический журнал (без записи нажимаемых клавиш)" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Открыть папку настроек" Click="OnOpenFolder" />
                        <Button Content="Сбросить настройки" Style="{StaticResource DangerButton}" Click="OnReset" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,8,0,0"
                               Text="Сброс возвращает параметры по умолчанию. Раскладки и калибровки устройств сохраняются." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
