<UserControl x:Class="NumPad.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NumPad.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Главная" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Тачпад превращается в цифровой блок по нажатию горячей клавиши." Style="{StaticResource Subtle}" Margin="0,0,0,16" />

            <Border x:Name="ErrorCard" Style="{StaticResource Card}" BorderBrush="{StaticResource ErrorBrush}" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ModeBadge" CornerRadius="12" Padding="12,4" Background="#E4E4E0" Margin="0,0,12,0">
                                <TextBlock x:Name="ModeBadgeText" Text="ВЫКЛ" FontWeight="Bold" FontSize="13" />
                            </Border>
                            <TextBlock x:Name="ModeTitle" Text="Режим NumPad выключен" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ModeHint" Style="{StaticResource Subtle}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button x:Name="ModeButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" MinWidth="170" Height="44"
                            Content="Включить NumPad" Click="OnToggle" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Устройство" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName" SelectionChanged="OnDeviceChanged" />
                        <TextBlock x:Name="DeviceStatus" Style="{StaticResource Subtle}" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Раскладка" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="LayoutBox" DisplayMemberPath="Name" SelectionChanged="OnLayoutChanged" />
                        <TextBlock x:Name="CalibrationStatus" Style="{StaticResource Subtle}" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Горячая клавиша" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBlock x:Name="HotkeyText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Subtle}" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Калибровка" Click="OnOpenCalibration" />
                            <Button Content="Редактор раскладки" Click="OnOpenEditor" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="Предпросмотр" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Subtle}" Text="Касания тачпада показываются в реальном времени; распознанные клавиши подсвечиваются." Margin="0,0,0,8" />
                    <c:LayoutCanvas x:Name="Preview" Height="300" />
                </StackPanel>
            </Border>

            <Border x:Name="WarningsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Предупреждения" Style="{StaticResource SectionTitle}" Foreground="{StaticResource WarningBrush}" />
                    <ItemsControl x:Name="WarningsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Скрыть" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnDismissWarnings" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
