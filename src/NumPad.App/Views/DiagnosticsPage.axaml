<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NumPad.App.Views.DiagnosticsPage">
    <Grid Margin="28,24,28,20" RowDefinitions="Auto,Auto,*">
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="Обновить устройства" />
                <Button x:Name="CopyButton" Content="Копировать отчёт" />
                <Button x:Name="OpenLogButton" Content="Открыть журнал" />
            </StackPanel>
            <TextBlock Classes="title" Text="Диагностика" />
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,12,*">
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Устройства" />
                    <SelectableTextBlock x:Name="DevicesText" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Состояние" />
                    <SelectableTextBlock x:Name="SummaryText" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
            <Border Classes="card" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="Касания (только на экране, не записываются)" />
                    <TextBlock x:Name="ContactsText" Classes="mono" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="Журнал" />
                    <TextBox x:Name="LogText" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="11" IsReadOnly="True"
                             TextWrapping="NoWrap" AcceptsReturn="True" BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
