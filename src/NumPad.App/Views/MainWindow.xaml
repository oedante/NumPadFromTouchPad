<Window x:Class="NumPad.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NumPad from TouchPad"
        Width="1120" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="20,22,20,22" Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/tray_on.png" Width="30" Height="30" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="NumPad" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="from TouchPad" Foreground="#A8A8A8" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Margin="14" Padding="12" CornerRadius="8" Background="#3C3C3C">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8A8A8A" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Выключен" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Foreground="#A8A8A8" FontSize="12" Margin="18,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="Nav">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" GroupName="Nav" Content="Главная" IsChecked="True" Checked="OnNav" Tag="home" />
                <RadioButton x:Name="NavLayout" Style="{StaticResource NavButton}" GroupName="Nav" Content="Раскладки" Checked="OnNav" Tag="layout" />
                <RadioButton x:Name="NavCalibration" Style="{StaticResource NavButton}" GroupName="Nav" Content="Калибровка" Checked="OnNav" Tag="calibration" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Content="Настройки" Checked="OnNav" Tag="settings" />
                <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavButton}" GroupName="Nav" Content="Диагностика" Checked="OnNav" Tag="diagnostics" />
            </StackPanel>
        </DockPanel>

        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
    </Grid>
</Window>
