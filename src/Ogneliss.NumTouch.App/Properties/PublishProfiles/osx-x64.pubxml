<?xml version="1.0" encoding="utf-8"?>
<!-- Релизная сборка osx-x64: self-contained, не требует установленного .NET.
     Управляемый код — в одном файле; нативные библиотеки (Avalonia, Skia, HarfBuzz) НЕ упаковываются внутрь
     (IncludeNativeLibrariesForSelfExtract=false), а лежат рядом в Contents/MacOS: так каждую можно подписать
     Developer ID с hardened runtime, а в .app остаются только файлы Mach-O — требование нотаризации. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>..\..\artifacts\osx-x64\</PublishDir>
  </PropertyGroup>
</Project>
