<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Ogneliss.NumTouch.App.Localization"
        x:Class="Ogneliss.NumTouch.App.Views.MainWindow"
        Title="Ogneliss NumTouch"
        Width="1140" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Icon="/Assets/app.ico">
    <Grid ColumnDefinitions="220,*">
        <!-- Боковая панель -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,22" Orientation="Horizontal" Spacing="12">
                <Image Source="/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ogneliss" Foreground="#A8A8A8" FontSize="12" />
                    <TextBlock Text="NumTouch" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Margin="14" Padding="14,12" CornerRadius="8" Background="#3C3C3C">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8A8A8A" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="{l:T 'NumPad off'}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="HotkeyChip" Classes="keycap dark" HorizontalAlignment="Left" Margin="18,0,0,0">
                        <TextBlock x:Name="HotkeyHint" Foreground="#E6E6E6" FontSize="12" />
                    </Border>
                    <Button x:Name="ExitButton" Classes="sidebar" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <PathIcon Width="13" Height="13" Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z" />
                            <TextBlock Text="{l:T 'Exit'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel x:Name="Nav" Spacing="2">
                <Button Classes="nav selected" Tag="home">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Width="17" Height="17" Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
                        <TextBlock Text="{l:T 'Home'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="nav" Tag="layout">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Width="17" Height="17" Data="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13Z" />
                        <TextBlock Text="{l:T 'Layouts'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="nav" Tag="calibration">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Width="17" Height="17" Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M3.05,13H1V11H3.05C3.5,6.83 6.83,3.5 11,3.05V1H13V3.05C17.17,3.5 20.5,6.83 20.95,11H23V13H20.95C20.5,17.17 17.17,20.5 13,20.95V23H11V20.95C6.83,20.5 3.5,17.17 3.05,13M12,5A7,7 0 0,0 5,12A7,7 0 0,0 12,19A7,7 0 0,0 19,12A7,7 0 0,0 12,5Z" />
                        <TextBlock Text="{l:T 'Calibration'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="nav" Tag="settings">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Width="17" Height="17" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                        <TextBlock Text="{l:T 'Settings'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="nav" Tag="diagnostics">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Width="17" Height="17" Data="M3,13H5.79L10.1,4.79L11.28,13.75L14.5,9.66L17.83,13H21V15H17L14.67,12.67L9.92,18.73L8.94,11.31L7,15H3V13Z" />
                        <TextBlock Text="{l:T 'Diagnostics'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
