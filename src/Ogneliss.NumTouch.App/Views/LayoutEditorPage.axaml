<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Ogneliss.NumTouch.App.Controls"
             xmlns:l="using:Ogneliss.NumTouch.App.Localization"
             x:Class="Ogneliss.NumTouch.App.Views.LayoutEditorPage">
    <Grid Margin="28,24,28,20" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Заголовок и сохранение -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="DirtyMark" Text="{l:T '● unsaved changes'}" Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Center" IsVisible="False" Margin="0,0,4,0" />
                <Button x:Name="RevertButton" Content="{l:T 'Discard changes'}" />
                <Button x:Name="SaveButton" Content="{l:T 'Save'}" />
                <Button x:Name="SaveApplyButton" Content="{l:T 'Save and apply'}" Classes="primary" />
            </StackPanel>
            <TextBlock Classes="title" Text="{l:T 'Layouts'}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Выбор раскладки и инструменты -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" MaxWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="LayoutBox" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <Button x:Name="LayoutMenuButton" Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center"
                    ToolTip.Tip="{l:T 'New, duplicate, import, export, restore'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{l:T 'Actions'}" VerticalAlignment="Center" />
                    <PathIcon Width="9" Height="9" Data="M0,0 L10,0 L5,6 Z" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="AddKeyButton" Classes="tool" ToolTip.Tip="{l:T 'Add a key to the right of the selected one'}">
                    <PathIcon Width="16" Height="16" Data="M1,4 H9 V12 H1 Z M2.5,5.5 V10.5 H7.5 V5.5 Z M12,5 H13.5 V7.25 H15.75 V8.75 H13.5 V11 H12 V8.75 H9.75 V7.25 H12 Z" />
                </Button>
                <Button x:Name="AddKeyBelowButton" Classes="tool" ToolTip.Tip="{l:T 'Add a key below the selected one'}">
                    <PathIcon Width="16" Height="16" Data="M4,1 H12 V9 H4 Z M5.5,2.5 V7.5 H10.5 V2.5 Z M7.25,10 H8.75 V12.25 H11 V13.75 H8.75 V16 H7.25 V13.75 H5 V12.25 H7.25 Z" />
                </Button>
                <Button x:Name="DeleteKeyButton" Classes="tool" ToolTip.Tip="{l:T 'Delete the selected key (Delete)'}">
                    <PathIcon Width="14" Height="14" Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z" />
                </Button>
                <Border Width="1" Height="22" Background="{StaticResource LineBrush}" Margin="6,0" />
                <Button x:Name="UndoButton" Classes="tool" ToolTip.Tip="{l:T 'Undo (Ctrl+Z)'}">
                    <PathIcon Width="15" Height="15" Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" />
                </Button>
                <Button x:Name="RedoButton" Classes="tool" ToolTip.Tip="{l:T 'Redo (Ctrl+Y)'}">
                    <PathIcon Width="15" Height="15" Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z" />
                </Button>
                <Border Width="1" Height="22" Background="{StaticResource LineBrush}" Margin="6,0" />
                <ToggleButton x:Name="SnapToggle" IsChecked="True" Classes="tool"
                              ToolTip.Tip="{l:T 'Snap to neighboring keys, the layout gap, the edges and the grid. Hold Alt while dragging to place freely.'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="14" Height="14" Data="M3,3H11V5H5V11H3V3M13,3H21V11H19V5H13V3M3,13H5V19H11V21H3V13M19,13H21V21H13V19H19V13M8,8H16V16H8V8Z" />
                        <TextBlock Text="{l:T 'Snap'}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,16,300">
            <Border Classes="card" Padding="8" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Classes="subtle" FontSize="12" Margin="8,6,8,2"
                               Text="{l:T 'Drag a key to move it; drag any edge or corner to resize. Keys snap to neighbors, the layout gap and the grid; Alt places freely, Shift moves along one axis. Arrows move the selected key, Alt+arrows resize it, Delete removes it. Live touches are drawn on top.'}" />
                    <c:LayoutCanvas x:Name="EditorCanvas" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" Margin="0" Padding="16,16,4,16">
                <ScrollViewer>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Classes="section" Text="{l:T 'Layout'}" />
                        <TextBlock Classes="label" Text="{l:T 'Name'}" Margin="0,0,0,3" />
                        <TextBox x:Name="NameBox" />
                        <Grid ColumnDefinitions="*,10,*" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Classes="label" Text="{l:T 'Aspect (W/H)'}" />
                                <TextBox x:Name="AspectBox" ToolTip.Tip="{l:T 'Width to height ratio of the sticker area'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="{l:T 'Key gap, %'}" />
                                <TextBox x:Name="GapBox" ToolTip.Tip="{l:T 'Gap between keys in % of the width; keys snap to it'}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="PointerOutsideBox" Content="{l:T 'Cursor outside keys'}" Margin="0,8,0,0"
                                  ToolTip.Tip="{l:T 'Touches outside the key rectangle move the cursor (like the trackpad zone in NUM10)'}" />

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12" />

                        <TextBlock x:Name="KeyHeader" Classes="section" Text="{l:T 'Key'}" />
                        <StackPanel x:Name="KeyPanel">
                            <TextBlock Classes="label" Text="{l:T 'Label on the diagram'}" Margin="0,0,0,3" />
                            <TextBox x:Name="LabelBox" />
                            <TextBlock Classes="label" Text="{l:T 'What the key does'}" />
                            <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{l:T 'Presses a key'}" Tag="Key" />
                                <ComboBoxItem Content="{l:T 'Presses a shortcut'}" Tag="Combo" />
                                <ComboBoxItem Content="{l:T 'Types text'}" Tag="Text" />
                                <ComboBoxItem Content="{l:T 'Nothing (empty zone)'}" Tag="None" />
                            </ComboBox>
                            <StackPanel x:Name="KeyChoicePanel">
                                <TextBlock Classes="label" Text="{l:T 'Key'}" />
                                <ComboBox x:Name="KeyBox" HorizontalAlignment="Stretch" MaxDropDownHeight="380" />
                            </StackPanel>
                            <WrapPanel x:Name="ModifiersPanel" Margin="0,6,0,0">
                                <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,0,12,0" />
                                <CheckBox x:Name="ModShift" Content="Shift" Margin="0,0,12,0" />
                                <CheckBox x:Name="ModAlt" Content="Alt" Margin="0,0,12,0" />
                                <CheckBox x:Name="ModWin" Content="Win / Cmd" />
                            </WrapPanel>
                            <StackPanel x:Name="TextPanel">
                                <TextBlock Classes="label" Text="{l:T 'Text'}" />
                                <TextBox x:Name="TextValueBox" />
                            </StackPanel>

                            <TextBlock Classes="label" Text="{l:T 'Position and size, % of the area'}" Margin="0,12,0,3" />
                            <Grid ColumnDefinitions="18,*,10,18,*" RowDefinitions="Auto,6,Auto">
                                <TextBlock Text="X" Classes="field" />
                                <TextBox x:Name="XBox" Grid.Column="1" />
                                <TextBlock Text="Y" Grid.Column="3" Classes="field" />
                                <TextBox x:Name="YBox" Grid.Column="4" />
                                <TextBlock Text="{l:T 'W'}" Grid.Row="2" Classes="field" />
                                <TextBox x:Name="WBox" Grid.Row="2" Grid.Column="1" />
                                <TextBlock Text="{l:T 'H'}" Grid.Row="2" Grid.Column="3" Classes="field" />
                                <TextBox x:Name="HBox" Grid.Row="2" Grid.Column="4" />
                            </Grid>
                            <CheckBox x:Name="EnabledBox" Content="{l:T 'Zone enabled'}" Margin="0,10,0,0" />
                            <CheckBox x:Name="RepeatBox" Content="{l:T 'Auto-repeat while held'}" />
                        </StackPanel>
                        <TextBlock x:Name="NoSelection" Classes="subtle" Text="{l:T 'Select a key on the diagram to change its position and action.'}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="IssuesText" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="72" />
    </Grid>
</UserControl>
