<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Ogneliss.NumTouch.App.Controls"
             xmlns:l="using:Ogneliss.NumTouch.App.Localization"
             x:Class="Ogneliss.NumTouch.App.Views.CalibrationPage">
    <Grid Margin="28,24,28,20" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="{l:T 'Calibration'}" />
            <TextBlock Classes="subtle" Margin="0,4,0,12"
                       Text="{l:T 'Calibration maps the real touch coordinates of the touchpad to the keys of the sticker. Run it after applying the sticker and when changing the layout.'}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Border x:Name="Step1Badge" CornerRadius="12" Padding="12,4"><TextBlock Text="{l:T '1. Preparation'}" /></Border>
            <Border x:Name="Step2Badge" CornerRadius="12" Padding="12,4"><TextBlock Text="{l:T '2. Touches'}" /></Border>
            <Border x:Name="Step3Badge" CornerRadius="12" Padding="12,4"><TextBlock Text="{l:T '3. Check and save'}" /></Border>
        </StackPanel>

        <!-- Шаг 1 -->
        <ScrollViewer x:Name="PrepareStep" Grid.Row="2" Padding="0,0,14,0">
            <StackPanel>
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="{l:T 'Device and layout'}" />
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="{l:T 'Touchpad'}" />
                                <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="{l:T 'Layout (sticker)'}" />
                                <ComboBox x:Name="LayoutBox" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CurrentCalibration" Classes="subtle" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="{l:T 'How calibration works'}" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22"
                                   Text="{l:T '1. The sticker must be on the touchpad; NumPad mode is turned off during calibration.&#10;2. The program highlights five keys one by one. Touch the center of the highlighted key on the sticker with one finger and lift it.&#10;3. The touches give the position, scale and tilt of the sticker. Then check the result: touch the keys and the recognized ones light up.'}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                            <Button x:Name="StartButton" Content="{l:T 'Start calibration'}" Classes="accent" />
                            <Button x:Name="TestCurrentButton" Content="{l:T 'Check current'}" />
                            <Button x:Name="ResetCalibrationButton" Content="{l:T 'Reset calibration'}" Classes="danger" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="{l:T 'Manual bounds'}" />
                        <TextBlock Classes="subtle" Margin="0,0,0,8"
                                   Text="{l:T 'Where the sticker is on the touchpad, in % of the touchpad width and height (0 = left/top edge). No rotation.'}" />
                        <WrapPanel>
                            <TextBlock Text="{l:T 'Left'}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="LeftBox" Width="70" Margin="0,0,16,6" />
                            <TextBlock Text="{l:T 'Top'}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="TopBox" Width="70" Margin="0,0,16,6" />
                            <TextBlock Text="{l:T 'Right'}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="RightBox" Width="70" Margin="0,0,16,6" />
                            <TextBlock Text="{l:T 'Bottom'}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="BottomBox" Width="70" Margin="0,0,16,6" />
                            <Button x:Name="ManualButton" Content="{l:T 'Check these bounds'}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock x:Name="ManualError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Шаг 2 -->
        <Grid x:Name="CaptureStep" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*,Auto">
            <Border Classes="card" Background="{DynamicResource HintBrush}" BorderBrush="{DynamicResource HintBorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="CaptureInstruction" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureProgress" Classes="subtle" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Classes="card" Padding="8">
                <c:LayoutCanvas x:Name="CaptureCanvas" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UndoPointButton" Content="{l:T 'Undo last point'}" />
                <Button x:Name="RestartButton" Content="{l:T 'Start over'}" />
                <Button x:Name="CancelCaptureButton" Content="{l:T 'Cancel'}" />
            </StackPanel>
        </Grid>

        <!-- Шаг 3 -->
        <Grid x:Name="TestStep" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*,Auto">
            <Border Classes="card">
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultDetails" Classes="subtle" Margin="0,4,0,0" />
                    <TextBlock Classes="subtle" Margin="0,8,0,0"
                               Text="{l:T 'Test: touch the keys on the sticker; the recognized key is highlighted. No keypresses are sent to other programs now.'}" />
                    <TextBlock x:Name="TestLog" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Classes="card" Padding="8">
                <c:LayoutCanvas x:Name="TestCanvas" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveCalibrationButton" Content="{l:T 'Save calibration'}" Classes="accent" />
                <Button x:Name="RepeatButton" Content="{l:T 'Repeat calibration'}" />
                <Button x:Name="CancelTestButton" Content="{l:T 'Cancel'}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
